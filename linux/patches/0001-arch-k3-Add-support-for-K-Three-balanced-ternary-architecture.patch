+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * arch/k3/include/asm/cacheflush.h
+ *
+ * Cache flushing and coherent DMA operations for K-Three.
+ *
+ * K-Three hardware has a unified flat memory space with coherent caches (no-op flush).
+ */
+
+#ifndef _ASM_K3_CACHEFLUSH_H
+#define _ASM_K3_CACHEFLUSH_H
+
+#define flush_cache_all()                       do { } while (0)
+#define flush_cache_mm(mm)                      do { } while (0)
+#define flush_cache_dup_mm(mm)                  do { } while (0)
+#define flush_cache_range(vma, start, end)      do { } while (0)
+#define flush_cache_page(vma, vmaddr, pfn)      do { } while (0)
+#define flush_dcache_page(page)                 do { } while (0)
+#define flush_dcache_mmap_lock(mapping)         do { } while (0)
+#define flush_dcache_mmap_unlock(mapping)       do { } while (0)
+#define flush_icache_range(start, end)          do { } while (0)
+#define flush_icache_page(vma, pg)              do { } while (0)
+#define flush_icache_user_range(vma, pg, adr, len) do { } while (0)
+#define flush_cache_vmap(start, end)            do { } while (0)
+#define flush_cache_vunmap(start, end)          do { } while (0)
+
+#endif /* _ASM_K3_CACHEFLUSH_H */
diff --git a/arch/k3/include/asm/delay.h b/arch/k3/include/asm/delay.h
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/arch/k3/include/asm/delay.h
@@ -0,0 +1,30 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * arch/k3/include/asm/delay.h
+ *
+ * Architecture-specific busy-wait delay routines for K-Three.
+ */
+
+#ifndef _ASM_K3_DELAY_H
+#define _ASM_K3_DELAY_H
+
+static inline void __delay(unsigned long loops)
+{
+    while (loops--) {
+        __asm__ __volatile__("" : : : "memory");
+    }
+}
+
+static inline void udelay(unsigned long usecs)
+{
+    __delay(usecs * 10);
+}
+
+static inline void mdelay(unsigned long msecs)
+{
+    while (msecs--) {
+        udelay(1000);
+    }
+}
+
+#endif /* _ASM_K3_DELAY_H */
