@@ -0,0 +1,97 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# arch/k3/Kconfig - K-Three Balanced Ternary Linux Architecture Configuration
+#
+
+config K3
+	def_bool y
+	select ARCH_HAS_CPU_FINALIZE_INIT
+	select ARCH_NO_COHERENT_DMA_MMAP
+	select GENERIC_ATOMIC64
+	select GENERIC_IRQ_SHOW
+	select HAVE_ARCH_KGDB
+	select HAVE_DYNAMIC_FTRACE
+	select SET_FS
+	help
+	  K-Three (Kord-Three) is a 9-trit balanced-ternary RISC processor
+	  architecture developed as an alternative to binary computing.
+	  Features:
+	  - Radix-3 balanced ternary (-1, 0, +1 trits)
+	  - 9 trits per word (symmetric range [-9841..+9841])
+	  - Flat word-addressed physical memory (6561 words, 9 pages of 729)
+	  - 8 general-purpose 9-trit registers (r0..r7)
+	  - Hardware MMIO, hardware timer IRQ, and DMA block storage
+
+config BALANCED_TERNARY
+	def_bool y
+	help
+	  This architecture uses balanced ternary arithmetic (powers of 3)
+	  instead of standard binary arithmetic.
+
+config MMU
+	def_bool n
+	help
+	  The baseline K-Three ISA v0 uses a flat word-addressed NOMMU
+	  memory model with hardware memory protection bounds.
+
+config PAGE_OFFSET
+	hex
+	default "0x0000"
+
+config STACK_POINTER_OFFSET
+	hex
+	default "0x19A0"
+
+config CPU_NAME
+	string
+	default "K-Three 9-Trit Balanced Ternary Processor"
+
+config HZ
+	int
+	default 100
+	help
+	  Hardware timer frequency in ticks per second.
+
+config K3_MAX_TASKS
+	int "Maximum number of simultaneous tasks"
+	default 8
+	help
+	  Maximum task table slots for embedded K-Three Linux.
+
+menu "K-Three Machine Setup"
+
+config K3_EXTENDED_MEMORY
+	bool "Support Extended 18/27-Trit Linear RAM Pool (16MB+)"
+	default y
+	help
+	  Enable extended linear memory addressing for running full Linux kernel
+	  and userspace workloads beyond the base 6561-word footprint.
+
+config K3_RAM_WORDS
+	int "Physical RAM words"
+	default 16777216 if K3_EXTENDED_MEMORY
+	default 6561
+	help
+	  Total physical memory words (default 16M words in extended mode, 6561 in legacy).
+
+config K3_KERNEL_WORDS
+	int "Kernel reserved memory words"
+	default 4194304 if K3_EXTENDED_MEMORY
+	default 1458
+	help
+	  Memory allocated to kernel code and data.
+
+config K3_USER_WORDS
+	int "Userspace memory words"
+	default 12582912 if K3_EXTENDED_MEMORY
+	default 5103
+	help
+	  Memory allocated to userspace tasks.
+
+config K3_HW_MMIO
+	bool "Hardware Memory-Mapped I/O support"
+	default y
+	help
+	  Enable direct hardware MMIO peripherals (UART, Timer, RNG, Disk DMA).
+
+endmenu
diff --git a/arch/k3/Makefile b/arch/k3/Makefile
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/arch/k3/Makefile
@@ -0,0 +1,31 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# arch/k3/Makefile - Linux Architecture Makefile for K-Three (Kord-Three)
+#
+
+KBUILD_DEFCONFIG := defconfig
+
+# Architecture compiler flags
+KBUILD_CFLAGS += -pipe -std=c11 -Wall -Wextra -Wpedantic
+KBUILD_CFLAGS += -D__K3__ -D__linux__
+KBUILD_AFLAGS += -D__K3__
+
+# Memory layout and stack conventions
+KBUILD_CFLAGS += -fno-builtin -ffreestanding
+
+# Kernel entry point and core object directories
+head-y := arch/k3/kernel/entry.o
+core-y += arch/k3/kernel/ arch/k3/fs/
+
+# Linker script
+KBUILD_LDS := arch/k3/kernel/vmlinux.lds
+
+all: vmlinux
+
+boot := arch/k3/boot
+
+vmlinux: $(head-y) $(core-y)
+
+PHONY += clean
+clean:
+	$(Q)$(MAKE) $(clean)=$(boot)
diff --git a/arch/k3/boot.c b/arch/k3/boot.c
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/arch/k3/boot.c
@@ -0,0 +1,89 @@
+/*
+ * arch/k3/boot.c
+ *
+ * Boot loader and kernel entry simulator for K-Three Ternary Linux.
+ * Boots the kernel, sets up hardware vectors, and starts /sbin/init (PID 1).
+ */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdbool.h>
+
+#include "vm.h"
+#include "image.h"
+#include "syscall.h"
+#include "io.h"
+#include "arch/k3/include/asm/processor.h"
+
+extern void k3_kernel_banner(void);
+extern void k3_setup_arch(k3_vm *vm, uint16_t trap_vector_addr);
+extern void k3_init_tasks(void);
+extern void k3_init_scheduler(void);
+extern void k3_timer_irq_tick(k3_vm *vm);
+
+static void kernel_step_hook(void *user, const k3_vm *vm)
+{
+    (void)user;
+    /* Hardware timer tick on every executed CPU cycle */
+    k3_timer_irq_tick((k3_vm *)vm);
+}
+
+int main(int argc, char **argv)
+{
+    const char *init_image = "build/userspace/kinit.k3";
+    if (argc > 1) {
+        init_image = argv[1];
+    }
+
+    /* 1. Print kernel boot dmesg banner */
+    k3_kernel_banner();
+
+    /* 2. Initialize tasks and scheduler structures */
+    k3_init_tasks();
+    k3_init_scheduler();
+
+    /* 3. Initialize K-Three VM Hardware & MMIO Subsystem */
+    k3_io_init();
+
+    k3_vm vm;
+    k3_vm_callbacks callbacks = {
+        .user = NULL,
+        .on_step = kernel_step_hook,
+        .on_stop = NULL,
+        .on_syscall = k3_host_syscall,
+        .on_mmio_read = k3_io_mmio_read,
+        .on_mmio_write = k3_io_mmio_write,
+    };
+    k3_vm_init(&vm, &callbacks);
+
+    /* 4. Setup kernel architecture hooks & trap vector */
+    k3_setup_arch(&vm, 0x0000);
+    k3_vm_set_user_bounds(&vm, 0, K3_VM_MAX_ADDRESS);
+
+    /* 5. Load /sbin/init image into user memory */
+    bt_word words[K3_VM_MEMORY_WORDS];
+    size_t count = 0;
+    if (!k3_image_read(init_image, words, K3_VM_MEMORY_WORDS, &count)) {
+        fprintf(stderr, "\033[1;31m[kernel panic] VFS: Unable to mount root fs or open %s\033[0m\n", init_image);
+        return 1;
+    }
+
+    if (!k3_vm_load(&vm, words, count, 0)) {
+        fprintf(stderr, "\033[1;31m[kernel panic] Failed to load %s into memory\033[0m\n", init_image);
+        return 1;
+    }
+
+    /* 6. Jump into user mode (PID 1) */
+    k3_vm_set_mode(&vm, K3_MODE_USER);
+
+    uint64_t executed = 0;
+    k3_vm_status status = k3_vm_run(&vm, 10000000, &executed);
+
+    if (status == K3_VM_HALTED) {
+        printf("\n\033[1;36m[kernel] System safely halted.\033[0m\n");
+    } else {
+        printf("\n\033[1;31m[kernel panic] Process 1 died with status %d\033[0m\n", status);
+    }
+
+    return (status == K3_VM_HALTED) ? 0 : 1;
+}
