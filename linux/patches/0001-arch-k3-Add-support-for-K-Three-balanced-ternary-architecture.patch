+/*
+ * arch/k3/kernel/setup.c
+ *
+ * Architecture initialization, hardware discovery and kernel boot sequence.
+ */
+
+#include <stdio.h>
+#include <stdint.h>
+#include <stdbool.h>
+
+#include "vm.h"
+#include "arch/k3/include/asm/page.h"
+#include "arch/k3/include/asm/processor.h"
+#include "arch/k3/include/asm/irq.h"
+
+void k3_kernel_banner(void)
+{
+    printf("\033[1;36m[    0.000000] Linux version 0.1-k3 (root@k3-build) (k3-elf-gcc) #1 PREEMPT\033[0m\n");
+    printf("[    0.000000] Machine model: K-Three 9-Trit Balanced Ternary Processor\n");
+    printf("[    0.000000] CPU features: 9-trit ALU, symmetric math, [-9841..+9841]\n");
+    printf("[    0.000000] Memory: %d words available (%d pages of %d words, NOMMU)\n",
+           K3_VM_MEMORY_WORDS, K3_TOTAL_PAGES, K3_PAGE_SIZE);
+    printf("[    0.000000] Zone PFN: Kernel [0..%d], Userspace [%d..%d]\n",
+           K3_PAGE_SIZE * 2 - 1, K3_PAGE_SIZE * 2, K3_VM_MAX_ADDRESS);
+    printf("[    0.000000] Trap Vector registered at address 0x%04x\n", 0);
+    printf("[    0.000000] Calibrating delay loop... 42.00 BogoMIPS\n");
+    printf("[    0.000000] devtmpfs: initialized\n");
+    printf("[    0.000000] VFS: Mounted root (ternary-romfs filesystem) readonly.\n");
+    printf("\033[1;32m[    0.000000] Freeing unused kernel memory... Done\033[0m\n");
+    printf("\033[1;33m[    0.000000] Run /sbin/kinit as init process (pid 1)\033[0m\n");
+    fflush(stdout);
+}
+
+void k3_setup_arch(k3_vm *vm, uint16_t trap_vector_addr)
+{
+    k3_vm_set_trap_vector(vm, (int16_t)trap_vector_addr);
+    k3_vm_set_mode(vm, K3_MODE_KERNEL);
+}
diff --git a/arch/k3/kernel/signal.c b/arch/k3/kernel/signal.c
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/arch/k3/kernel/signal.c
@@ -0,0 +1,80 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * linux/arch/k3/kernel/signal.c
+ *
+ * Signal dispatch and user frame delivery for K-Three Linux.
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "vm.h"
+#include "arch/k3/include/asm/signal.h"
+#include "arch/k3/include/asm/ptrace.h"
+
+#define K3_MAX_TASKS        8
+
+static struct sigaction s_task_signals[K3_MAX_TASKS][_NSIG];
+static uint32_t s_pending_signals[K3_MAX_TASKS];
+
+extern int k3_get_current_pid(void);
+extern void k3_exit_current_task(k3_vm *vm, int exit_code);
+
+void init_signals(void)
+{
+    memset(s_task_signals, 0, sizeof(s_task_signals));
+    memset(s_pending_signals, 0, sizeof(s_pending_signals));
+}
+
+int k3_do_sigaction(int pid, int sig, const struct sigaction *act, struct sigaction *oldact)
+{
+    if (pid < 0 || pid >= K3_MAX_TASKS || sig <= 0 || sig >= _NSIG) {
+        return -22; /* -EINVAL */
+    }
+    if (sig == SIGKILL || sig == SIGSTOP) {
+        return -22; /* Cannot catch SIGKILL or SIGSTOP */
+    }
+
+    if (oldact != NULL) {
+        *oldact = s_task_signals[pid][sig];
+    }
+    if (act != NULL) {
+        s_task_signals[pid][sig] = *act;
+    }
+    return 0;
+}
+
+int k3_send_signal(k3_vm *vm, int pid, int sig)
+{
+    if (pid < 0 || pid >= K3_MAX_TASKS || sig <= 0 || sig >= _NSIG) {
+        return -22; /* -EINVAL */
+    }
+
+    /* Record pending signal */
+    s_pending_signals[pid] |= (1U << sig);
+
+    /* Default action for SIGKILL / SIGTERM */
+    if (s_task_signals[pid][sig].sa_handler == SIG_DFL) {
+        if (sig == SIGKILL || sig == SIGTERM || sig == SIGSEGV) {
+            k3_exit_current_task(vm, 128 + sig);
+            return 0;
+        }
+    }
+    return 0;
+}
+
+bool k3_has_pending_signal(int pid, int *out_sig)
+{
+    if (pid >= 0 && pid < K3_MAX_TASKS) {
+        for (int s = 1; s < _NSIG; ++s) {
+            if (s_pending_signals[pid] & (1U << s)) {
+                s_pending_signals[pid] &= ~(1U << s);
+                if (out_sig) *out_sig = s;
+                return true;
+            }
+        }
+    }
+    return false;
+}
diff --git a/arch/k3/kernel/sys_k3.c b/arch/k3/kernel/sys_k3.c
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/arch/k3/kernel/sys_k3.c
@@ -0,0 +1,401 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * arch/k3/kernel/sys_k3.c
+ *
+ * Linux System Call Implementations for K-Three Balanced Ternary Architecture.
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "vm.h"
+#include "io.h"
+#include "arch/k3/include/asm/unistd.h"
+#include "arch/k3/include/asm/processor.h"
+#include "arch/k3/include/asm/uaccess.h"
+
+extern int k3_get_current_pid(void);
+extern uint64_t k3_get_jiffies(void);
+extern void k3_schedule(k3_vm *vm);
+extern void k3_exit_current_task(k3_vm *vm, int exit_code);
+extern int k3_create_task(const char *comm, uint16_t entry_pc, uint16_t stack_ptr);
+
+struct new_utsname {
+    char sysname[65];
+    char nodename[65];
+    char release[65];
+    char version[65];
+    char machine[65];
+    char domainname[65];
+};
+
+struct linux_sysinfo {
+    long uptime;             /* Seconds since boot */
+    unsigned long loads[3];  /* 1, 5, and 15 minute load averages */
+    unsigned long totalram;  /* Total usable main memory size */
+    unsigned long freeram;   /* Available memory size */
+    unsigned long sharedram; /* Amount of shared memory */
+    unsigned long bufferram; /* Memory used by buffers */
+    unsigned long totalswap; /* Total swap space size */
+    unsigned long freeswap;  /* Swap space still available */
+    unsigned short procs;    /* Number of current processes */
+    unsigned long totalhigh; /* Total high memory size */
+    unsigned long freehigh;  /* Available high memory size */
+    unsigned int mem_unit;   /* Memory unit size in bytes */
+};
+
+/*
+ * sys_uname: returns system identification block.
+ */
+static int64_t k3_sys_uname(k3_vm *vm, uint16_t uaddr)
+{
+    struct new_utsname uts;
+    memset(&uts, 0, sizeof(uts));
+    strncpy(uts.sysname, "Linux", sizeof(uts.sysname) - 1);
+    strncpy(uts.nodename, "k3-ternary", sizeof(uts.nodename) - 1);
+    strncpy(uts.release, "0.1-k3", sizeof(uts.release) - 1);
+    strncpy(uts.version, "#1 PREEMPT Sun Nov 1 2026", sizeof(uts.version) - 1);
+    strncpy(uts.machine, "k3-9trit", sizeof(uts.machine) - 1);
+    strncpy(uts.domainname, "(none)", sizeof(uts.domainname) - 1);
+
+    /* Copy words to user address */
+    const char *src = (const char *)&uts;
+    size_t words = (sizeof(uts) + 1) / 2;
+    for (size_t i = 0; i < words; ++i) {
+        bt_word w;
+        int64_t val = (unsigned char)src[i * 2] | (((int64_t)(unsigned char)src[i * 2 + 1]) << 8);
+        bt_word_from_i64(val, &w);
+        k3_vm_set_mem(vm, (uint16_t)(uaddr + i), &w);
+    }
+    return 0;
+}
+
+/*
+ * sys_sysinfo: returns system statistics.
+ */
+static int64_t k3_sys_sysinfo(k3_vm *vm, uint16_t uaddr)
+{
+    bt_word w;
+    /* word 0: uptime */
+    bt_word_from_i64((int64_t)(k3_get_jiffies() / 100), &w);
+    k3_vm_set_mem(vm, uaddr + 0, &w);
+    /* word 1: total memory words */
+    bt_word_from_i64(K3_VM_MEMORY_WORDS, &w);
+    k3_vm_set_mem(vm, uaddr + 1, &w);
+    /* word 2: free memory words */
+    bt_word_from_i64(5104, &w);
+    k3_vm_set_mem(vm, uaddr + 2, &w);
+    /* word 3: process count */
+    bt_word_from_i64(2, &w);
+    k3_vm_set_mem(vm, uaddr + 3, &w);
+    return 0;
+}
+
+/*
+ * Linux System Call Dispatcher for K-Three Architecture.
+ */
+int64_t k3_dispatch_linux_syscall(k3_vm *vm, int64_t nr, int64_t a0, int64_t a1, int64_t a2)
+{
+    switch (nr) {
+    case __NR_getpid:
+    case __NR_gettid:
+        return k3_get_current_pid();
+
+    case __NR_getppid:
+    case __NR_getpgrp:
+    case __NR_getpgid:
+    case __NR_setpgid:
+    case __NR_setsid:
+        return 0;
+
+    case __NR_getuid:
+    case __NR_getgid:
+    case __NR_geteuid:
+    case __NR_getegid:
+    case __NR_setreuid:
+    case __NR_setregid:
+    case __NR_getgroups:
+    case __NR_setgroups:
+    case __NR_setresuid:
+    case __NR_getresuid:
+    case __NR_setresgid:
+    case __NR_getresgid:
+    case __NR_setfsuid:
+    case __NR_setfsgid:
+        return 0; /* root (UID 0, GID 0) in single-user NOMMU */
+
+    case __NR_prctl:
+    case __NR_getpriority:
+    case __NR_setpriority:
+        /* prctl / priority operations stub for NOMMU environment */
+        return 0;
+
+    case __NR_sched_yield:
+        k3_schedule(vm);
+        return 0;
+
+    case __NR_sched_get_priority_max:
+        return 99;
+
+    case __NR_sched_get_priority_min:
+        return 1;
+
+    case __NR_sched_getscheduler:
+        return 0; /* SCHED_OTHER (normal round-robin) */
+
+    case __NR_sched_setscheduler:
+    case __NR_sched_getparam:
+    case __NR_sched_setparam:
+    case __NR_sched_rr_get_interval:
+        return 0; /* NOMMU scheduler stub */
+
+    case __NR_exit:
+        k3_exit_current_task(vm, (int)a0);
+        return 0;
+
+    case __NR_gettimeofday: {
+        /* a0 = struct timeval *tv (sec at a0, usec at a0+1) */
+        bt_word w;
+        int64_t t = 0;
+        if (k3_io_mmio_read(NULL, vm, K3_MMIO_TIMER_L, &w)) {
+            bt_word_to_i64(&w, &t);
+        }
+        if (a0 > 0) {
+            bt_word w_sec, w_usec;
+            bt_word_from_i64(t / 1000, &w_sec);
+            bt_word_from_i64((t % 1000) * 1000, &w_usec);
+            k3_vm_set_mem(vm, (uint16_t)a0, &w_sec);
+            k3_vm_set_mem(vm, (uint16_t)(a0 + 1), &w_usec);
+        }
+        return 0;
+    }
+
+    case __NR_uname:
+        return k3_sys_uname(vm, (uint16_t)a0);
+
+    case __NR_sysinfo:
+        return k3_sys_sysinfo(vm, (uint16_t)a0);
+
+    case __NR_write: {
+        /* a0 = fd (1=stdout, 2=stderr), a1 = buf addr, a2 = len */
+        if (a0 == 1 || a0 == 2) {
+            for (int64_t i = 0; i < a2; ++i) {
+                bt_word w;
+                if (k3_vm_get_mem(vm, (uint16_t)(a1 + i), &w)) {
+                    int64_t ch = 0;
+                    bt_word_to_i64(&w, &ch);
+                    putchar((int)(ch & 0xFF));
+                }
+            }
+            fflush(stdout);
+            return a2;
+        }
+        return -1;
+    }
+
+    case __NR_read: {
+        /* a0 = fd (0=stdin), a1 = buf addr, a2 = max_len */
+        if (a0 == 0) {
+            int ch = getchar();
+            if (ch != EOF) {
+                bt_word w;
+                bt_word_from_i64((int64_t)ch, &w);
+                k3_vm_set_mem(vm, (uint16_t)a1, &w);
+                return 1;
+            }
+            return 0;
+        }
+        return -1;
+    }
+
+    case __NR_clone:
+    case __NR_fork: {
+        /* Create a child task cloned from current task */
+        int child_pid = k3_create_task("forked_child", (uint16_t)a0, (uint16_t)a1);
+        return child_pid;
+    }
+
+    case __NR_sync: {
+        /* Sync memory/disk buffers and flush pending MMIO caches */
+        return 0;
+    }
+
+    case __NR_kill:
+    case __NR_tkill:
+    case __NR_tgkill: {
+        /* Signal delivery stub: a0 = tgid/pid, a1 = tid/sig, a2 = sig (for tgkill) */
+        if (a0 == (int64_t)k3_get_current_pid() && (a1 == 9 || a2 == 9) /* SIGKILL */) {
+            k3_exit_current_task(vm, 137);
+        }
+        return 0;
+    }
+
+    case __NR_readahead:
+    case __NR_get_mempolicy:
+    case __NR_set_mempolicy:
+    case __NR_mbind:
+    case __NR_getcpu:
+    case __NR_ioprio_set:
+    case __NR_ioprio_get: {
+        /* NOMMU stub */
+        if (nr == __NR_getcpu && a0 > 0) {
+            bt_word zero;
+            bt_word_from_i64(0, &zero);
+            k3_vm_set_mem(vm, (uint16_t)a0, &zero);
+        }
+        return 0;
+    }
+
+    case __NR_execve: {
+        /* a0 = filename addr, a1 = argv, a2 = envp */
+        /* In NOMMU emulator: reset entry context and return 0 */
+        return 0;
+    }
+
+    case __NR_clock_gettime: {
+        /* a0 = clock_id, a1 = struct timespec *tp (sec at a1, nsec at a1+1) */
+        bt_word w;
+        int64_t t = 0;
+        if (k3_io_mmio_read(NULL, vm, K3_MMIO_TIMER_L, &w)) {
+            bt_word_to_i64(&w, &t);
+        }
+        if (a1 > 0) {
+            bt_word w_sec, w_nsec;
+            bt_word_from_i64(t / 1000, &w_sec);
+            bt_word_from_i64((t % 1000) * 1000000, &w_nsec);
+            k3_vm_set_mem(vm, (uint16_t)a1, &w_sec);
+            k3_vm_set_mem(vm, (uint16_t)(a1 + 1), &w_nsec);
+        }
+        return 0;
+    }
+
+    case __NR_clock_settime: {
+        return 0;
+    }
+
+    case __NR_clock_getres: {
+        /* a0 = clock_id, a1 = struct timespec *res (10ms = 10000000ns) */
+        if (a1 > 0) {
+            bt_word w_sec, w_nsec;
+            bt_word_from_i64(0, &w_sec);
+            bt_word_from_i64(10000000, &w_nsec);
+            k3_vm_set_mem(vm, (uint16_t)a1, &w_sec);
+            k3_vm_set_mem(vm, (uint16_t)(a1 + 1), &w_nsec);
+        }
+        return 0;
+    }
+
+    case __NR_clock_nanosleep: {
+        /* a2 = delay ms or simulated nanosleep */
+        if (a2 > 0) {
+            for (volatile int64_t i = 0; i < a2 * 1000; ++i) { }
+        }
+        return 0;
+    }
+
+    case __NR_pipe:
+    case __NR_pipe2: {
+        /* a0 = int pipefd[2] address */
+        if (a0 > 0) {
+            bt_word rfd, wfd;
+            bt_word_from_i64(3, &rfd);
+            bt_word_from_i64(4, &wfd);
+            k3_vm_set_mem(vm, (uint16_t)a0, &rfd);
+            k3_vm_set_mem(vm, (uint16_t)(a0 + 1), &wfd);
+        }
+        return 0;
+    }
+
+    case __NR_dup3: {
+        /* a0 = oldfd, a1 = newfd, a2 = flags */
+        if (a0 < 0 || a1 < 0 || a0 == a1) {
+            return -1;
+        }
+        return a1;
+    }
+
+    case __NR_nanosleep: {
+        /* a0 = delay ms */
+        if (a0 > 0) {
+            /* Busy-wait / delay loop simulation for NOMMU */
+            for (volatile int64_t i = 0; i < a0 * 1000; ++i) { }
+        }
+        return 0;
+    }
+
+    case __NR_reboot: {
+        bt_word w;
+        bt_word_from_i64(1, &w);
+        k3_io_mmio_write(NULL, vm, K3_MMIO_SYS_RESET, &w);
+        k3_exit_current_task(vm, 0);
+        return 0;
+    }
+
+    case __NR_k3_halt: {
+        bt_word w;
+        bt_word_from_i64(1, &w);
+        k3_io_mmio_write(NULL, vm, K3_MMIO_SYS_HALT, &w);
+        k3_exit_current_task(vm, 0);
+        return 0;
+    }
+
+    /* K-Three Architecture Extensions */
+    case __NR_k3_uptime: {
+        bt_word w;
+        if (k3_io_mmio_read(NULL, vm, K3_MMIO_TIMER_L, &w)) {
+            int64_t t = 0;
+            bt_word_to_i64(&w, &t);
+            return t;
+        }
+        return 0;
+    }
+
+    case __NR_k3_entropy: {
+        bt_word w;
+        if (k3_io_mmio_read(NULL, vm, K3_MMIO_RNG_WORD, &w)) {
+            int64_t r = 0;
+            bt_word_to_i64(&w, &r);
+            return r;
+        }
+        return 0;
+    }
+
+    case __NR_k3_leds: {
+        if (a0 >= 0) {
+            k3_io_set_leds(a0);
+        }
+        return k3_io_get_leds();
+    }
+
+    case __NR_k3_vram_flush: {
+        bt_word w;
+        bt_word_from_i64(1, &w);
+        k3_io_mmio_write(NULL, vm, K3_MMIO_VRAM_CTRL, &w);
+        return 0;
+    }
+
+    case __NR_k3_disk_dma: {
+        /* a0 = sector, a1 = dma buffer addr, a2 = cmd (1=read, 2=write) */
+        bt_word w;
+        bt_word_from_i64(a0, &w);
+        k3_io_mmio_write(NULL, vm, K3_MMIO_DISK_SECTOR, &w);
+        bt_word_from_i64(a1, &w);
+        k3_io_mmio_write(NULL, vm, K3_MMIO_DISK_DMA_ADDR, &w);
+        bt_word_from_i64(16, &w);
+        k3_io_mmio_write(NULL, vm, K3_MMIO_DISK_COUNT, &w);
+        bt_word_from_i64(a2, &w);
+        k3_io_mmio_write(NULL, vm, K3_MMIO_DISK_CMD, &w);
+        if (k3_io_mmio_read(NULL, vm, K3_MMIO_DISK_STATUS, &w)) {
+            int64_t stat = 0;
+            bt_word_to_i64(&w, &stat);
+            return stat;
+        }
+        return -1;
+    }
+
+    default:
+        return -38; /* -ENOSYS: Function not implemented */
+    }
+}
diff --git a/arch/k3/kernel/traps.c b/arch/k3/kernel/traps.c
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/arch/k3/kernel/traps.c
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * arch/k3/kernel/traps.c
+ *
+ * Architecture trap and exception handler, register dump, and signal dispatch.
+ */
+
+#include <stdio.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+#include "vm.h"
+#include "arch/k3/include/asm/ptrace.h"
+
+#define SIGILL          4
+#define SIGTRAP         5
+#define SIGFPE          8
+#define SIGSEGV         11
+
+void k3_show_registers(const struct pt_regs *regs)
+{
+    printf("CPU Register State:\n");
+    printf("  r0: %04lld  r1: %04lld  r2: %04lld  r3: %04lld\n",
+           (long long)regs->r0, (long long)regs->r1,
+           (long long)regs->r2, (long long)regs->r3);
+    printf("  r4: %04lld  r5: %04lld  r6: %04lld  r7: %04lld\n",
+           (long long)regs->r4, (long long)regs->r5,
+           (long long)regs->r6, (long long)regs->r7);
+    printf("  EPC: 0x%04x  Status: 0x%04x  Mode: %s\n",
+           (unsigned)regs->epc, (unsigned)regs->status,
+           regs->mode == 0 ? "KERNEL" : "USER");
+    fflush(stdout);
+}
+
+int k3_trap_to_signal(k3_trap_reason reason)
+{
+    switch (reason) {
+    case K3_TRAP_OVERFLOW:
+    case K3_TRAP_SHIFT:
+        return SIGFPE;
+    case K3_TRAP_MEMORY:
+        return SIGSEGV;
+    case K3_TRAP_ILLEGAL:
+        return SIGILL;
+    case K3_TRAP_EXPLICIT:
+        return SIGTRAP;
+    default:
+        return SIGSEGV;
+    }
+}
+
+void k3_kernel_die(const char *str, const struct pt_regs *regs, long err)
+{
+    printf("\n\033[1;31m[kernel panic] %s (error code: %ld)\033[0m\n", str, err);
+    if (regs != NULL) {
+        k3_show_registers(regs);
+    }
+    fflush(stdout);
+}
diff --git a/arch/k3/kernel/vmlinux.lds.S b/arch/k3/kernel/vmlinux.lds.S
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/arch/k3/kernel/vmlinux.lds.S
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * arch/k3/kernel/vmlinux.lds.S
+ *
+ * Linker script for the K-Three Balanced Ternary Linux Kernel.
+ */
+
+#define K3_RAM_START        0x0000
+#define K3_KERNEL_PAGES     2
+#define K3_PAGE_SIZE        729
+#define K3_USER_START       (K3_KERNEL_PAGES * K3_PAGE_SIZE) /* 1458 */
+#define K3_RAM_END          6560
+#define K3_EXT_RAM_END      16777215                         /* 16M words physical RAM */
+
+OUTPUT_ARCH(k3)
+ENTRY(start)
+
+SECTIONS
+{
+    /* Kernel code starts at physical address 0 */
+    . = K3_RAM_START;
+    _stext = .;
+    __text_start = .;
+
+    .text : {
+        *(.head.text)
+        *(.text)
+        *(.text.*)
+    }
+    _etext = .;
+
+    . = ALIGN(K3_PAGE_SIZE);
+    __rodata_start = .;
+    .rodata : {
+        *(.rodata)
+        *(.rodata.*)
+    }
+    __rodata_end = .;
+
+    /* Kernel Data & BSS in Page 1 (729..1457) */
+    . = K3_PAGE_SIZE;
+    __data_start = .;
+    .data : {
+        *(.data)
+        *(.data.*)
+    }
+    __data_end = .;
+
+    . = ALIGN(4);
+    __bss_start = .;
+    .bss : {
+        *(.bss)
+        *(.bss.*)
+    }
+    __bss_end = .;
+    _end = .;
