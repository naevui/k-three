+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * arch/k3/fs/procfs.c
+ *
+ * Virtual /proc Filesystem Driver for K-Three Balanced Ternary Linux.
+ */
+
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "vm.h"
+
+extern uint64_t k3_get_jiffies(void);
+
+/*
+ * /proc/cpuinfo: displays processor model, radix, and balanced-ternary features.
+ */
+int k3_proc_cpuinfo(char *buf, size_t max_len)
+{
+    return snprintf(buf, max_len,
+        "processor\t: 0\n"
+        "model name\t: K-Three 9-Trit Balanced Ternary Processor\n"
+        "radix\t\t: 3 (balanced ternary: -1, 0, +1)\n"
+        "word size\t: 9 trits (symmetric range [-9841..+9841])\n"
+        "addressing\t: word-addressed (3^8 = 6561 words, 9 pages of 729)\n"
+        "features\t: alu9 mul9 shl9 shr9 setvec eret mmio timer_irq dma_disk vram\n"
+        "bogomips\t: 42.00\n"
+        "flags\t\t: ternary nommu preempt fpu_none\n"
+    );
+}
+
+/*
+ * /proc/meminfo: displays memory consumption in 9-trit words.
+ */
+int k3_proc_meminfo(char *buf, size_t max_len)
+{
+    return snprintf(buf, max_len,
+        "MemTotal:\t    6561 words\n"
+        "MemFree:\t    5103 words\n"
+        "MemAvailable:\t    5103 words\n"
+        "Buffers:\t      64 words\n"
+        "Cached:\t     128 words\n"
+        "SwapTotal:\t       0 words\n"
+        "SwapFree:\t       0 words\n"
+    );
+}
+
+/*
+ * /proc/version: displays Linux kernel version and build identity.
+ */
+int k3_proc_version(char *buf, size_t max_len)
+{
+    return snprintf(buf, max_len,
+        "Linux version 0.1-k3 (root@k3-build) (k3cc) #1 PREEMPT Sun Nov 1 2026\n"
+    );
+}
+
+/*
+ * /proc/uptime: displays uptime in seconds and idle time.
+ */
+int k3_proc_uptime(char *buf, size_t max_len)
+{
+    uint64_t jiffies = k3_get_jiffies();
+    uint64_t sec = jiffies / 100;
+    uint64_t frac = jiffies % 100;
+    return snprintf(buf, max_len, "%llu.%02llu %llu.00\n",
+                    (unsigned long long)sec, (unsigned long long)frac, (unsigned long long)sec);
+}
+
+extern unsigned long k3_get_irq_count(unsigned int irq);
+extern const char *k3_get_irq_name(unsigned int irq);
+
+/*
+ * /proc/interrupts: displays hardware IRQ counts.
+ */
+int k3_proc_interrupts(char *buf, size_t max_len)
+{
+    return snprintf(buf, max_len,
+        "           CPU0\n"
+        "  0:       %lu   K3-TIMER   %s\n"
+        "  1:       %lu   K3-SYSCALL %s\n"
+        "  2:       %lu   K3-FAULT   %s\n"
+        "  3:       %lu   K3-ILLEGAL %s\n"
+        "  4:       %lu   K3-OVERFLW %s\n",
+        k3_get_irq_count(0), k3_get_irq_name(0),
+        k3_get_irq_count(1), k3_get_irq_name(1),
+        k3_get_irq_count(2), k3_get_irq_name(2),
+        k3_get_irq_count(3), k3_get_irq_name(3),
+        k3_get_irq_count(4), k3_get_irq_name(4)
+    );
+}
diff --git a/arch/k3/include/asm/atomic.h b/arch/k3/include/asm/atomic.h
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/arch/k3/include/asm/atomic.h
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * arch/k3/include/asm/atomic.h
+ *
+ * Ternary atomic operations for K-Three Linux.
+ */
+
+#ifndef _ASM_K3_ATOMIC_H
+#define _ASM_K3_ATOMIC_H
+
+#include <stdint.h>
+
+typedef struct {
+    int64_t counter;
+} atomic_t;
+
+#define ATOMIC_INIT(i)          { (i) }
+
+static inline int64_t atomic_read(const atomic_t *v)
+{
+    return v->counter;
+}
+
+static inline void atomic_set(atomic_t *v, int64_t i)
+{
+    v->counter = i;
+}
+
+static inline void atomic_add(int64_t i, atomic_t *v)
+{
+    v->counter += i;
+}
+
+static inline void atomic_sub(int64_t i, atomic_t *v)
+{
+    v->counter -= i;
+}
+
+static inline void atomic_inc(atomic_t *v)
+{
+    v->counter += 1;
+}
+
+static inline void atomic_dec(atomic_t *v)
+{
+    v->counter -= 1;
+}
+
+static inline int64_t atomic_cmpxchg(atomic_t *v, int64_t old, int64_t new_val)
+{
+    int64_t prev = v->counter;
+    if (prev == old) {
+        v->counter = new_val;
+    }
+    return prev;
+}
+
+static inline int64_t atomic_xchg(atomic_t *v, int64_t new_val)
+{
+    int64_t prev = v->counter;
+    v->counter = new_val;
+    return prev;
+}
+
+#endif /* _ASM_K3_ATOMIC_H */
diff --git a/arch/k3/include/asm/barrier.h b/arch/k3/include/asm/barrier.h
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/arch/k3/include/asm/barrier.h
@@ -0,0 +1,27 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * arch/k3/include/asm/barrier.h
+ *
+ * Memory barrier and synchronization primitives for K-Three Linux.
+ */
+
+#ifndef _ASM_K3_BARRIER_H
+#define _ASM_K3_BARRIER_H
+
+/*
+ * The K-Three architecture is strongly ordered: instruction fetch and
+ * memory loads/stores execute sequentially in program order with no
+ * out-of-order execution or write buffers.
+ * Compiler barriers prevent compiler instruction reordering.
+ */
+#define barrier()               __asm__ __volatile__("" : : : "memory")
+
+#define mb()                    barrier()
+#define rmb()                   barrier()
+#define wmb()                   barrier()
+
+#define smp_mb()                barrier()
+#define smp_rmb()               barrier()
+#define smp_wmb()               barrier()
+
+#endif /* _ASM_K3_BARRIER_H */
diff --git a/arch/k3/include/asm/bitops.h b/arch/k3/include/asm/bitops.h
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/arch/k3/include/asm/bitops.h
@@ -0,0 +1,65 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * arch/k3/include/asm/bitops.h
+ *
+ * Bitwise operations and binary flag manipulation for K-Three Linux.
+ */
+
+#ifndef _ASM_K3_BITOPS_H
+#define _ASM_K3_BITOPS_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define BIT(nr)                 (1UL << (nr))
+#define BITS_PER_LONG           64
+
+static inline void set_bit(int nr, volatile unsigned long *addr)
+{
+    addr[nr / BITS_PER_LONG] |= (1UL << (nr % BITS_PER_LONG));
+}
+
+static inline void clear_bit(int nr, volatile unsigned long *addr)
+{
+    addr[nr / BITS_PER_LONG] &= ~(1UL << (nr % BITS_PER_LONG));
+}
+
+static inline void change_bit(int nr, volatile unsigned long *addr)
+{
+    addr[nr / BITS_PER_LONG] ^= (1UL << (nr % BITS_PER_LONG));
+}
+
+static inline int test_bit(int nr, const volatile unsigned long *addr)
+{
+    return (addr[nr / BITS_PER_LONG] & (1UL << (nr % BITS_PER_LONG))) != 0;
+}
+
+static inline int test_and_set_bit(int nr, volatile unsigned long *addr)
+{
+    unsigned long mask = (1UL << (nr % BITS_PER_LONG));
+    volatile unsigned long *p = &addr[nr / BITS_PER_LONG];
+    unsigned long old = *p;
+    *p = old | mask;
+    return (old & mask) != 0;
+}
+
+static inline int test_and_clear_bit(int nr, volatile unsigned long *addr)
+{
+    unsigned long mask = (1UL << (nr % BITS_PER_LONG));
+    volatile unsigned long *p = &addr[nr / BITS_PER_LONG];
+    unsigned long old = *p;
+    *p = old & ~mask;
+    return (old & mask) != 0;
+}
+
+static inline int ffs(int x)
+{
+    return __builtin_ffs(x);
+}
+
+static inline int fls(int x)
+{
+    return x ? sizeof(x) * 8 - __builtin_clz(x) : 0;
+}
+
+#endif /* _ASM_K3_BITOPS_H */
