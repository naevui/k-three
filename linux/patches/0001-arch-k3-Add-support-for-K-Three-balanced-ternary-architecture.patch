diff --git a/arch/k3/kernel/irq.c b/arch/k3/kernel/irq.c
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/arch/k3/kernel/irq.c
@@ -0,0 +1,92 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * arch/k3/kernel/irq.c
+ *
+ * Linux interrupt management and dispatch subsystem for K-Three.
+ */
+
+#include <stdio.h>
+#include <string.h>
+
+#include "vm.h"
+#include "arch/k3/include/asm/irq.h"
+#include "arch/k3/include/asm/ptrace.h"
+
+typedef int (*irq_handler_t)(int irq, void *dev_id);
+
+struct irq_action {
+    irq_handler_t handler;
+    void *dev_id;
+    const char *name;
+    unsigned long count;
+    bool active;
+};
+
+static struct irq_action s_irq_actions[K3_NR_IRQS];
+
+void init_IRQ(void)
+{
+    memset(s_irq_actions, 0, sizeof(s_irq_actions));
+
+    /* Pre-register default hardware timer IRQ 0 */
+    s_irq_actions[K3_IRQ_TIMER].name = "timer";
+    s_irq_actions[K3_IRQ_TIMER].active = true;
+
+    /* Pre-register syscall trap IRQ 1 */
+    s_irq_actions[K3_IRQ_SYSCALL].name = "syscall";
+    s_irq_actions[K3_IRQ_SYSCALL].active = true;
+}
+
+int request_irq(unsigned int irq, irq_handler_t handler, unsigned long flags,
+                const char *name, void *dev_id)
+{
+    (void)flags;
+    if (irq >= K3_NR_IRQS || handler == NULL) {
+        return -22; /* -EINVAL */
+    }
+
+    s_irq_actions[irq].handler = handler;
+    s_irq_actions[irq].dev_id = dev_id;
+    s_irq_actions[irq].name = name ? name : "unnamed";
+    s_irq_actions[irq].active = true;
+    return 0;
+}
+
+void free_irq(unsigned int irq, void *dev_id)
+{
+    if (irq < K3_NR_IRQS) {
+        if (s_irq_actions[irq].dev_id == dev_id) {
+            s_irq_actions[irq].handler = NULL;
+            s_irq_actions[irq].dev_id = NULL;
+            s_irq_actions[irq].active = false;
+        }
+    }
+}
+
+void do_IRQ(k3_vm *vm, unsigned int irq, struct pt_regs *regs)
+{
+    (void)vm;
+    (void)regs;
+    if (irq < K3_NR_IRQS) {
+        s_irq_actions[irq].count++;
+        if (s_irq_actions[irq].handler != NULL) {
+            s_irq_actions[irq].handler((int)irq, s_irq_actions[irq].dev_id);
+        }
+    }
+}
+
+unsigned long k3_get_irq_count(unsigned int irq)
+{
+    if (irq < K3_NR_IRQS) {
+        return s_irq_actions[irq].count;
+    }
+    return 0;
+}
+
+const char *k3_get_irq_name(unsigned int irq)
+{
+    if (irq < K3_NR_IRQS && s_irq_actions[irq].name != NULL) {
+        return s_irq_actions[irq].name;
+    }
+    return "none";
+}
diff --git a/arch/k3/kernel/process.c b/arch/k3/kernel/process.c
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/arch/k3/kernel/process.c
@@ -0,0 +1,67 @@
+/*
+ * arch/k3/kernel/process.c
+ *
+ * Process management and context switching (switch_to) for K-Three.
+ */
+
+#include <stdio.h>
+#include <string.h>
+#include "vm.h"
+#include "arch/k3/include/asm/processor.h"
+
+#define K3_MAX_TASKS 4
+
+struct task_struct {
+    int pid;
+    char comm[16];
+    struct thread_struct thread;
+    bt_word regs[K3_VM_REGISTER_COUNT];
+    uint16_t pc;
+    int state; /* 0 = RUNNING, 1 = SLEEPING, 2 = ZOMBIE */
+};
+
+static struct task_struct g_task_table[K3_MAX_TASKS];
+static int g_current_pid = 0;
+
+void k3_init_tasks(void)
+{
+    memset(g_task_table, 0, sizeof(g_task_table));
+
+    /* Task 0: swapper / idle */
+    g_task_table[0].pid = 0;
+    strncpy(g_task_table[0].comm, "swapper", sizeof(g_task_table[0].comm) - 1);
+    g_task_table[0].state = 0;
+
+    /* Task 1: /sbin/init */
+    g_task_table[1].pid = 1;
+    strncpy(g_task_table[1].comm, "init", sizeof(g_task_table[1].comm) - 1);
+    g_task_table[1].state = 0;
+}
+
+/*
+ * Low-level context switch between two K-Three processes.
+ */
+void k3_switch_to(k3_vm *vm, int prev_pid, int next_pid)
+{
+    if (prev_pid < 0 || prev_pid >= K3_MAX_TASKS ||
+        next_pid < 0 || next_pid >= K3_MAX_TASKS) {
+        return;
+    }
+
+    struct task_struct *prev = &g_task_table[prev_pid];
+    struct task_struct *next = &g_task_table[next_pid];
+
+    /* 1. Save architecture state of prev task */
+    for (int i = 0; i < K3_VM_REGISTER_COUNT; ++i) {
+        prev->regs[i] = vm->regs[i];
+    }
+    prev->pc = vm->pc;
+
+    /* 2. Restore architecture state of next task */
+    for (int i = 0; i < K3_VM_REGISTER_COUNT; ++i) {
+        vm->regs[i] = next->regs[i];
+    }
+    vm->pc = next->pc;
+
+    g_current_pid = next_pid;
+}
diff --git a/arch/k3/kernel/sched.c b/arch/k3/kernel/sched.c
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/arch/k3/kernel/sched.c
@@ -0,0 +1,197 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * arch/k3/kernel/sched.c
+ *
+ * Preemptive Task Scheduler & Context Switching for K-Three Linux.
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "vm.h"
+#include "arch/k3/include/asm/processor.h"
+#include "arch/k3/include/asm/ptrace.h"
+#include "arch/k3/include/asm/page.h"
+
+#define K3_MAX_TASKS        8
+
+#define TASK_RUNNING        0
+#define TASK_INTERRUPTIBLE  1
+#define TASK_STOPPED        2
+#define TASK_ZOMBIE         3
+
+struct task_struct {
+    int pid;
+    int ppid;
+    char comm[16];
+    int state;
+    uint64_t utime;
+    uint64_t stime;
+    int priority;
+    int timeslice;
+
+    /* Architectural Context */
+    bt_word regs[K3_VM_REGISTER_COUNT];
+    uint16_t pc;
+    uint8_t mode;
+};
+
+static struct task_struct s_tasks[K3_MAX_TASKS];
+static int s_current_pid = 0;
+static uint64_t s_jiffies = 0;
+
+void k3_init_scheduler(void)
+{
+    memset(s_tasks, 0, sizeof(s_tasks));
+
+    /* Task 0: swapper (idle daemon) */
+    s_tasks[0].pid = 0;
+    s_tasks[0].ppid = 0;
+    strncpy(s_tasks[0].comm, "swapper", sizeof(s_tasks[0].comm) - 1);
+    s_tasks[0].state = TASK_RUNNING;
+    s_tasks[0].priority = 20;
+    s_tasks[0].timeslice = 5;
+
+    /* Task 1: /sbin/kinit */
+    s_tasks[1].pid = 1;
+    s_tasks[1].ppid = 0;
+    strncpy(s_tasks[1].comm, "kinit", sizeof(s_tasks[1].comm) - 1);
+    s_tasks[1].state = TASK_RUNNING;
+    s_tasks[1].priority = 20;
+    s_tasks[1].timeslice = 5;
+
+    s_current_pid = 1; /* Start with kinit */
+    s_jiffies = 0;
+}
+
+int k3_get_current_pid(void)
+{
+    return s_current_pid;
+}
+
+uint64_t k3_get_jiffies(void)
+{
+    return s_jiffies;
+}
+
+const char *k3_get_task_comm(int pid)
+{
+    if (pid >= 0 && pid < K3_MAX_TASKS) {
+        return s_tasks[pid].comm;
+    }
+    return "unknown";
+}
+
+int k3_create_task(const char *comm, uint16_t entry_pc, uint16_t stack_ptr)
+{
+    for (int i = 2; i < K3_MAX_TASKS; ++i) {
+        if (s_tasks[i].state == TASK_ZOMBIE || s_tasks[i].pid == 0) {
+            s_tasks[i].pid = i;
+            s_tasks[i].ppid = s_current_pid;
+            strncpy(s_tasks[i].comm, comm, sizeof(s_tasks[i].comm) - 1);
+            s_tasks[i].comm[sizeof(s_tasks[i].comm) - 1] = '\0';
+            s_tasks[i].state = TASK_RUNNING;
+            s_tasks[i].priority = 20;
+            s_tasks[i].timeslice = 5;
+            s_tasks[i].pc = entry_pc;
+            s_tasks[i].mode = K3_MODE_USER;
+
+            /* Zero registers except stack pointer r7 */
+            for (int r = 0; r < K3_VM_REGISTER_COUNT; ++r) {
+                bt_word_zero(&s_tasks[i].regs[r]);
+            }
+            bt_word sp;
+            bt_word_from_i64((int64_t)stack_ptr, &sp);
+            s_tasks[i].regs[7] = sp;
+
+            return i;
+        }
+    }
+    return -1; /* Out of task slots */
+}
+
+/*
+ * Low-level context switch between two K-Three processes.
+ */
+static void do_context_switch(k3_vm *vm, int prev_pid, int next_pid)
+{
+    if (prev_pid == next_pid) return;
+
+    struct task_struct *prev = &s_tasks[prev_pid];
+    struct task_struct *next = &s_tasks[next_pid];
+
+    /* 1. Save architecture state of current task */
+    for (int i = 0; i < K3_VM_REGISTER_COUNT; ++i) {
+        prev->regs[i] = vm->regs[i];
+    }
+    prev->pc = vm->pc;
+    prev->mode = (uint8_t)k3_vm_get_mode(vm);
+
+    /* 2. Restore architecture state of next task */
+    for (int i = 0; i < K3_VM_REGISTER_COUNT; ++i) {
+        vm->regs[i] = next->regs[i];
+    }
+    vm->pc = next->pc;
+    k3_vm_set_mode(vm, (k3_vm_mode)next->mode);
+
+    s_current_pid = next_pid;
+}
+
+/*
+ * Round-robin preemptive scheduler.
+ */
+void k3_schedule(k3_vm *vm)
+{
+    if (vm == NULL) return;
+
+    int next_pid = -1;
+
+    /* Scan task table starting from current + 1 */
+    for (int offset = 1; offset <= K3_MAX_TASKS; ++offset) {
+        int candidate = (s_current_pid + offset) % K3_MAX_TASKS;
+        if (s_tasks[candidate].pid > 0 && s_tasks[candidate].state == TASK_RUNNING) {
+            next_pid = candidate;
+            break;
+        }
+    }
+
+    if (next_pid < 0) {
+        /* Default to idle task (0) */
+        next_pid = 0;
+    }
+
+    if (next_pid != s_current_pid) {
+        do_context_switch(vm, s_current_pid, next_pid);
+    }
+}
+
+/*
+ * Hardware Timer IRQ handler: updates jiffies and decrements timeslice.
+ */
+void k3_timer_irq_tick(k3_vm *vm)
+{
+    s_jiffies++;
+
+    struct task_struct *cur = &s_tasks[s_current_pid];
+    if (cur->state == TASK_RUNNING) {
+        if (k3_vm_get_mode(vm) == K3_MODE_USER) {
+            cur->utime++;
+        } else {
+            cur->stime++;
+        }
+
+        if (--cur->timeslice <= 0) {
+            cur->timeslice = 5; /* Reset timeslice */
+            k3_schedule(vm);    /* Preempt and switch task! */
+        }
+    }
+}
+
+void k3_exit_current_task(k3_vm *vm, int exit_code)
+{
+    (void)exit_code;
+    s_tasks[s_current_pid].state = TASK_ZOMBIE;
+    k3_schedule(vm);
+}
